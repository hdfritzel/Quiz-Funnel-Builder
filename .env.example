# Kopiere diese Datei zu .env.local und trage die echten Werte ein.
# Siehe quiz-funnel-builder-spec.md, Abschnitt 8.

# Anthropic API-Key (server-seitig, für /api/generate)
ANTHROPIC_API_KEY=

# Optional: überschreibt das Standard-Modell (claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Stripe (Test- oder Live-Keys aus dem Stripe-Dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Vercel KV (Redis) — aus dem Vercel-Dashboard nach dem Anlegen der KV-Datenbank
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Quentn (E-Mail-Marketing-Automation) — API-Key für den Trigger-Call im
# Stripe-Webhook nach erfolgreichem Kauf
QUENTN_API_KEY=

# Öffentliche Basis-URL der App (ohne trailing slash), z.B. https://quiz-funnel-builder.vercel.app
# Für lokale Entwicklung: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
